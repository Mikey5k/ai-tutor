# Copy this file to .env and fill in your keys
# The startup.bat reads these automatically

# Required: Claude API (for lesson generation, answer evaluation)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required: Gemini Flash (for vision fallback)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: OpenRouter (alternative to Anthropic direct — covers Claude + free models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Deepgram (cloud STT — use instead of local Whisper on low-RAM machines)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Vision provider: "gemini" (default) or "moondream" (local offline)
VISION_PROVIDER=gemini

# SearXNG URL (self-hosted search for resource fetching)
# Run with: docker run -d -p 8080:8080 searxng/searxng
SEARXNG_URL=http://localhost:8080
